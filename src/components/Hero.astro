---
---

<section class="hero-gradient hero-pattern text-white relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 py-20 md:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="animate-fade-in">
        <span class="inline-block bg-white/15 text-white text-xs font-semibold px-3 py-1 rounded-full mb-6 tracking-wide">
          App para psicólogos
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight">
          O prontu&aacute;rio que entende<br/>sua abordagem.
        </h1>
        <p class="text-lg md:text-xl text-white/75 mt-6 leading-relaxed max-w-xl">
          14 abordagens cl&iacute;nicas. IA adaptativa. Artigos cient&iacute;ficos reais.
          Funciona offline. O &uacute;nico prontu&aacute;rio que se adapta ao seu m&eacute;todo
          &mdash; TCC, Psican&aacute;lise, ACT, DBT e mais.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-10">
          <a href="/#download"
            class="bg-white text-primary hover:bg-gray-100 font-bold px-8 py-4 rounded-xl text-center transition-all hover:shadow-lg">
            <span class="flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Baixar para Android
            </span>
          </a>
          <a href="/precos"
            class="border-2 border-white/30 hover:border-white/60 text-white font-semibold px-8 py-4 rounded-xl text-center transition-all">
            Ver planos
          </a>
        </div>
        <div class="flex flex-wrap gap-8 mt-14 text-white/70 text-sm">
          <div class="stat-number">
            <span class="font-extrabold text-white text-3xl">14</span>
            <p class="text-white/60 text-xs mt-1">abordagens cl&iacute;nicas</p>
          </div>
          <div class="stat-number">
            <span class="font-extrabold text-white text-3xl">100%</span>
            <p class="text-white/60 text-xs mt-1">funciona offline</p>
          </div>
          <div class="stat-number">
            <span class="font-extrabold text-white text-3xl">0</span>
            <p class="text-white/60 text-xs mt-1">papel na sua mesa</p>
          </div>
          <div class="stat-number">
            <span class="font-extrabold text-white text-3xl">5</span>
            <p class="text-white/60 text-xs mt-1">escalas integradas</p>
          </div>
        </div>
      </div>

      <div class="hidden lg:flex justify-center animate-fade-in delay-1">
        <div class="phone-frame">
          <div class="phone-notch"></div>
          <div class="phone-screen bg-white overflow-hidden relative">
            <img src="/home-screen.jpeg" alt="MentAll - Tela Home" class="absolute inset-0 w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
