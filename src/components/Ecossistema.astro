---
---

<section id="ecossistema" class="max-w-6xl mx-auto px-4 py-20 md:py-28">
  <div class="text-center max-w-2xl mx-auto">
    <span class="text-primary font-semibold text-sm uppercase tracking-wider">Ecossistema</span>
    <h2 class="text-3xl md:text-4xl font-bold text-text-heading mt-3">
      Tudo em um &uacute;nico lugar
    </h2>
    <p class="text-text-muted mt-4">
      Agenda, prontu&aacute;rio, financeiro, pacientes e IA
      trabalhando juntos em um &uacute;nico sistema.
    </p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-14">
    <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center card-hover group">
      <div class="icon-box bg-blue-50 text-primary mx-auto group-hover:bg-primary group-hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <h4 class="font-semibold text-text-heading mt-3 text-sm">Agenda</h4>
      <p class="text-xs text-text-muted mt-1">Lembretes e<br/>confirma&ccedil;&otilde;es</p>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center card-hover group">
      <div class="icon-box bg-indigo-50 text-indigo-600 mx-auto group-hover:bg-indigo-600 group-hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      </div>
      <h4 class="font-semibold text-text-heading mt-3 text-sm">Prontu&aacute;rio</h4>
      <p class="text-xs text-text-muted mt-1">14 abordagens<br/>cl&iacute;nicas</p>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center card-hover group">
      <div class="icon-box bg-purple-50 text-purple-600 mx-auto group-hover:bg-purple-600 group-hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </div>
      <h4 class="font-semibold text-text-heading mt-3 text-sm">IA Cl&iacute;nica</h4>
      <p class="text-xs text-text-muted mt-1">S&iacute;ntese e<br/>transcri&ccedil;&atilde;o</p>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center card-hover group">
      <div class="icon-box bg-green-50 text-green-600 mx-auto group-hover:bg-green-600 group-hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
      <h4 class="font-semibold text-text-heading mt-3 text-sm">Financeiro</h4>
      <p class="text-xs text-text-muted mt-1">Pacotes e<br/>controle</p>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center card-hover group">
      <div class="icon-box bg-teal-50 text-teal-600 mx-auto group-hover:bg-teal-600 group-hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
      </div>
      <h4 class="font-semibold text-text-heading mt-3 text-sm">Escalas</h4>
      <p class="text-xs text-text-muted mt-1">PHQ-9, GAD-7,<br/>BDI, BAI</p>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center card-hover group">
      <div class="icon-box bg-orange-50 text-orange-600 mx-auto group-hover:bg-orange-600 group-hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      </div>
      <h4 class="font-semibold text-text-heading mt-3 text-sm">Anamnese</h4>
      <p class="text-xs text-text-muted mt-1">Question&aacute;rio<br/>digital</p>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center card-hover group">
      <div class="icon-box bg-rose-50 text-rose-600 mx-auto group-hover:bg-rose-600 group-hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M10 12l2 2 4-4"/></svg>
      </div>
      <h4 class="font-semibold text-text-heading mt-3 text-sm">Contrato</h4>
      <p class="text-xs text-text-muted mt-1">Acordo<br/>Terap&ecirc;utico</p>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center card-hover group">
      <div class="icon-box bg-cyan-50 text-cyan-600 mx-auto group-hover:bg-cyan-600 group-hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </div>
      <h4 class="font-semibold text-text-heading mt-3 text-sm">Progress Tracking</h4>
      <p class="text-xs text-text-muted mt-1">Evolu&ccedil;&atilde;o<br/>autom&aacute;tica</p>
    </div>
  </div>
</section>
