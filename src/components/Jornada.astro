---
---

<section class="bg-primary-bg py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto">
      <span class="text-primary font-semibold text-sm uppercase tracking-wider">Jornada</span>
      <h2 class="text-3xl md:text-4xl font-bold text-text-heading mt-3">
        Tudo flui. Antes, durante<br/>e depois da sess&atilde;o.
      </h2>
    </div>

    <div class="relative mt-16">
      <!-- Timeline line -->
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-0.5 bg-primary/20 -translate-x-1/2"></div>

      <div class="space-y-12 md:space-y-20">
        <!-- Antes -->
        <div class="relative md:flex items-center gap-12">
          <div class="hidden md:block flex-1 text-right pr-8">
            <span class="text-xs font-semibold text-orange-600 uppercase tracking-wider">Antes</span>
            <h3 class="text-xl font-bold text-text-heading mt-1">Agenda e prepara&ccedil;&atilde;o</h3>
            <p class="text-sm text-text-muted mt-2 max-w-xs ml-auto leading-relaxed">
              Lembretes autom&aacute;ticos, confirma&ccedil;&atilde;o do paciente,
              revis&atilde;o do hist&oacute;rico e anota&ccedil;&otilde;es da sess&atilde;o anterior.
            </p>
          </div>
          <div class="hidden md:flex w-10 h-10 bg-orange-100 rounded-full items-center justify-center z-10 flex-shrink-0 border-4 border-primary-bg">
            <span class="text-orange-600 text-sm font-bold">1</span>
          </div>
          <div class="md:hidden bg-white rounded-2xl p-6 card-hover">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
                <span class="text-orange-600 text-sm font-bold">1</span>
              </div>
              <span class="text-xs font-semibold text-orange-600 uppercase">Antes</span>
            </div>
            <h3 class="text-lg font-bold text-text-heading mb-2">Agenda e prepara&ccedil;&atilde;o</h3>
            <p class="text-sm text-text-muted leading-relaxed">
              Lembretes autom&aacute;ticos, confirma&ccedil;&atilde;o do paciente,
              revis&atilde;o do hist&oacute;rico e anota&ccedil;&otilde;es da sess&atilde;o anterior.
            </p>
          </div>
          <div class="hidden md:block flex-1"></div>
        </div>

        <!-- Durante -->
        <div class="relative md:flex items-center gap-12">
          <div class="hidden md:block flex-1"></div>
          <div class="hidden md:flex w-10 h-10 bg-blue-100 rounded-full items-center justify-center z-10 flex-shrink-0 border-4 border-primary-bg">
            <span class="text-blue-600 text-sm font-bold">2</span>
          </div>
          <div class="hidden md:block flex-1 pl-8">
            <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Durante</span>
            <h3 class="text-xl font-bold text-text-heading mt-1">Grava&ccedil;&atilde;o e transcri&ccedil;&atilde;o</h3>
            <p class="text-sm text-text-muted mt-2 max-w-xs leading-relaxed">
              Grave o &aacute;udio da sess&atilde;o. A IA transcreve e gera
              s&iacute;ntese cl&iacute;nica, formula&ccedil;&atilde;o e interven&ccedil;&otilde;es
              adaptadas &agrave; sua abordagem.
            </p>
          </div>
          <div class="md:hidden bg-white rounded-2xl p-6 card-hover">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                <span class="text-blue-600 text-sm font-bold">2</span>
              </div>
              <span class="text-xs font-semibold text-blue-600 uppercase">Durante</span>
            </div>
            <h3 class="text-lg font-bold text-text-heading mb-2">Grava&ccedil;&atilde;o e transcri&ccedil;&atilde;o</h3>
            <p class="text-sm text-text-muted leading-relaxed">
              Grave o &aacute;udio da sess&atilde;o. A IA transcreve e gera
              s&iacute;ntese cl&iacute;nica, formula&ccedil;&atilde;o e interven&ccedil;&otilde;es.
            </p>
          </div>
        </div>

        <!-- Depois -->
        <div class="relative md:flex items-center gap-12">
          <div class="hidden md:block flex-1 text-right pr-8">
            <span class="text-xs font-semibold text-green-600 uppercase tracking-wider">Depois</span>
            <h3 class="text-xl font-bold text-text-heading mt-1">Prontu&aacute;rio e evolu&ccedil;&atilde;o</h3>
            <p class="text-sm text-text-muted mt-2 max-w-xs ml-auto leading-relaxed">
              Prontu&aacute;rio completo com revis&atilde;o profissional,
              artigos sugeridos, progress tracking e controle financeiro integrado.
            </p>
          </div>
          <div class="hidden md:flex w-10 h-10 bg-green-100 rounded-full items-center justify-center z-10 flex-shrink-0 border-4 border-primary-bg">
            <span class="text-green-600 text-sm font-bold">3</span>
          </div>
          <div class="md:hidden bg-white rounded-2xl p-6 card-hover">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                <span class="text-green-600 text-sm font-bold">3</span>
              </div>
              <span class="text-xs font-semibold text-green-600 uppercase">Depois</span>
            </div>
            <h3 class="text-lg font-bold text-text-heading mb-2">Prontu&aacute;rio e evolu&ccedil;&atilde;o</h3>
            <p class="text-sm text-text-muted leading-relaxed">
              Prontu&aacute;rio completo, artigos sugeridos, progress tracking e financeiro.
            </p>
          </div>
          <div class="hidden md:block flex-1"></div>
        </div>
      </div>
    </div>
  </div>
</section>
