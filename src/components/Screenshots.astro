---

<section class="max-w-6xl mx-auto px-4 py-20 md:py-28">
  <div class="text-center max-w-2xl mx-auto">
    <span class="text-primary font-semibold text-sm uppercase tracking-wider">Demonstra&ccedil;&atilde;o</span>
    <h2 class="text-3xl md:text-4xl font-bold text-text-heading mt-3">
      Veja o MentAll em a&ccedil;&atilde;o
    </h2>
    <p class="text-text-muted mt-4">
      Algumas telas do aplicativo que v&atilde;o transformar sua rotina cl&iacute;nica.
    </p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-14">
    <a href="/home-screen.jpeg" target="_blank" class="bg-white border border-gray-100 rounded-2xl p-3 card-hover text-center group block">
      <div class="bg-primary-bg rounded-xl overflow-hidden aspect-[9/19] mb-3 flex items-center justify-center relative">
        <img src="/home-screen.jpeg" alt="Tela Home do MentAll" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      </div>
      <p class="font-semibold text-sm text-text-heading">Home e Dashboard</p>
      <p class="text-xs text-text-muted mt-1">KPIs, agenda, atividade recente</p>
    </a>

    <a href="/designer-mockup.png" target="_blank" class="bg-white border border-gray-100 rounded-2xl p-3 card-hover text-center group block">
      <div class="bg-primary-bg rounded-xl overflow-hidden aspect-[9/19] mb-3 flex items-center justify-center relative">
        <img src="/designer-mockup.png" alt="Tela de Sessão do MentAll" class="absolute inset-0 w-full h-full object-contain" loading="lazy" />
      </div>
      <p class="font-semibold text-sm text-text-heading">Sess&atilde;o com IA</p>
      <p class="text-xs text-text-muted mt-1">S&iacute;ntese, formula&ccedil;&atilde;o, artigos</p>
    </a>

    <a href="/designer-mockup2.png" target="_blank" class="bg-white border border-gray-100 rounded-2xl p-3 card-hover text-center group block">
      <div class="bg-primary-bg rounded-xl overflow-hidden aspect-[9/19] mb-3 flex items-center justify-center relative">
        <img src="/designer-mockup2.png" alt="Tela do MentAll" class="absolute inset-0 w-full h-full object-contain" loading="lazy" />
      </div>
      <p class="font-semibold text-sm text-text-heading">Painel Financeiro</p>
      <p class="text-xs text-text-muted mt-1">KPIs, pacotes, status de pagamento</p>
    </a>

    <div class="bg-white border border-gray-100 rounded-2xl p-3 card-hover text-center group">
      <div class="bg-primary-bg rounded-xl aspect-[9/19] flex items-center justify-center mb-3 relative overflow-hidden">
        <div class="absolute inset-0 bg-white flex flex-col p-4">
          <div class="flex items-center gap-2 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <span class="text-xs text-text-heading font-bold">Evolução Clínica</span>
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2 text-xs"><span class="text-green-600 font-bold">↓</span><span>Insônia — 3/10</span></div>
            <div class="flex items-center gap-2 text-xs"><span class="text-red-600 font-bold">↑</span><span>Ansiedade — 7/10</span></div>
            <div class="flex items-center gap-2 text-xs"><span class="text-gray-400 font-bold">→</span><span>Humor — 5/10</span></div>
          </div>
          <div class="mt-3 bg-green-50 rounded-lg p-2">
            <p class="text-xs text-green-700 italic">Melhora no sono, ansiedade elevada</p>
          </div>
        </div>
      </div>
      <p class="font-semibold text-sm text-text-heading">Evolu&ccedil;&atilde;o Cl&iacute;nica</p>
      <p class="text-xs text-text-muted mt-1">Progress tracking autom&aacute;tico</p>
    </div>
  </div>
</section>
