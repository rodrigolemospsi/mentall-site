---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main class="max-w-6xl mx-auto px-4 py-20">
    <h1 class="text-4xl font-bold text-text-heading text-center">Planos</h1>
    <p class="text-text-muted text-center mt-3">Escolha o plano ideal para sua pr&aacute;tica.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-14 max-w-3xl mx-auto">
      <div class="bg-white border border-gray-200 rounded-2xl p-8">
        <span class="text-xs font-semibold text-primary uppercase">Gr&aacute;tis</span>
        <div class="mt-3"><span class="text-4xl font-extrabold text-text-heading">R$ 0</span><span class="text-text-muted">/m&ecirc;s</span></div>
        <p class="text-sm text-text-muted mt-2">Ideal para come&ccedil;ar</p>
        <ul class="mt-6 space-y-3 text-sm text-text-body">
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Agenda e lembretes</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Prontu&aacute;rio com 14 abordagens</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Pacotes de sess&otilde;es</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Escalas psicol&oacute;gicas</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Contrato Terap&ecirc;utico</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Financeiro b&aacute;sico</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Anamnese digital</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Backup e restaura&ccedil;&atilde;o</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Exporta&ccedil;&atilde;o de PDFs</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> App profissional offline</li>
        </ul>
        <a href="/#download"
          class="block text-center border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold py-3 rounded-xl mt-8 transition-colors">
          Baixar gr&aacute;tis
        </a>
      </div>

      <div class="bg-primary-bg border-2 border-primary rounded-2xl p-8 relative">
        <span class="absolute -top-3 left-6 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full">Recomendado</span>
        <span class="text-xs font-semibold text-primary uppercase">Premium</span>
        <div class="mt-3"><span class="text-4xl font-extrabold text-text-heading">R$ XX</span><span class="text-text-muted">/m&ecirc;s</span></div>
        <p class="text-sm text-text-muted mt-2">Tudo do Gr&aacute;tis + IA e ilimitado</p>
        <ul class="mt-6 space-y-3 text-sm text-text-body">
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> <strong>Tudo do plano Gr&aacute;tis</strong></li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Transcri&ccedil;&atilde;o de &aacute;udio por IA</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> S&iacute;ntese cl&iacute;nica por IA</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Artigos cient&iacute;ficos sugeridos</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Progress Tracking autom&aacute;tico</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Pacientes ilimitados</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> App do paciente (em breve)</li>
          <li class="flex items-start gap-2"><span class="text-green-500">&#10003;</span> Suporte priorit&aacute;rio</li>
        </ul>
        <a href="/contato"
          class="block text-center bg-primary hover:bg-primary-dark text-white font-semibold py-3 rounded-xl mt-8 transition-colors">
          Entrar em contato
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
